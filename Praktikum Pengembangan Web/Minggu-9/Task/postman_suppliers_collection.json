        },
        "url": {
          "raw": "{{baseUrl}}/api/suppliers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "suppliers"
          ]
        },
        "description": "Membuat supplier baru pada tabel `suppliers`."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code harus 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response harus berupa JSON', function () {",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "",
              "let jsonData = pm.response.json();",
              "",
              "pm.test('Harus ada properti message', function () {",
              "    pm.expect(jsonData).to.have.property('message');",
              "});",
              "",
              "pm.test('Harus ada properti insertedId', function () {",
              "    pm.expect(jsonData).to.have.property('insertedId');",
              "});",
              "",
              "// Simpan insertedId sebagai variable collection supplierId",
              "pm.collectionVariables.set('supplierId', jsonData.insertedId);"
            ]
          }
        }
      ]
    },
