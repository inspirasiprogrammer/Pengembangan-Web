<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Item</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
  <div class="container mt-5">
    <h1 id="judul" class="text-primary text-center mb-4">Edit Item</h1>
    <form class="border p-4 bg-white shadow rounded">
      <div class="mb-3">
        <label for="name" class="form-label">Nama Item</label>
        <input type="text" id="name" class="form-control" value="<%= barang.name %>" required />
      </div>
      <div class="mb-3">
        <label for="qty_stock" class="form-label">Stok Item</label>
        <input type="number" id="qty_stock" class="form-control" min="0" value="<%= barang.qty_stock %>" required />
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Harga Item</label>
        <input type="number" id="price" class="form-control" min="0" value="<%= barang.price %>" required />
      </div>
      <input type="hidden" id="id" value="<%= barang.id %>" />
      <div class="d-flex justify-content-between">
        <button type="submit" id="editData" class="btn btn-primary">Simpan Data Item</button>
        <button type="button" id="batal" class="btn btn-secondary" onclick="history.back()">Kembali</button>
      </div>
    </form>
  </div>

  <script>
    async function editData(event) {
      event.preventDefault();

      const id = document.getElementById("id").value;
      const name = document.getElementById("name").value;
      const qty_stock = parseInt(document.getElementById("qty_stock").value);
      const price = parseInt(document.getElementById("price").value);

      const result = await fetch(`/api/items/${id}`, {
        method: "PUT",
        headers: { "Content-type": "application/json" },
        body: JSON.stringify({ name, qty_stock, price })
      });

      if (!result.ok) {
        alert("Gagal memperbaharui data item");
        return;
      }

      const response = await result.json();
      if (response.response) {
        alert("Data item berhasil diperbaharui");
        window.location.href = "/";
      } else {
        alert("Gagal memperbaharui data item");
      }
    }

    document.querySelector("form").addEventListener("submit", editData);
  </script>
</body>
</html>